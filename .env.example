# ============================================================
# 施工日志系统 · 环境变量模板
# 复制为 .env 后按实际环境填写（.env 已被 .gitignore 忽略，不会入库）：
#   cp .env.example .env
# config.py 启动时自动 load_dotenv() 读取
# ============================================================

# ---- 运行环境 ----
# development / production
# 生产由 gunicorn 启动（wsgi.py 里 setdefault FLASK_CONFIG=production，
# 也可在此显式指定）
FLASK_CONFIG=production
FLASK_DEBUG=false

# ---- 安全（生产必须改！）----
# 签名 token / session 密钥。生成随机值：
#   python -c "import secrets; print(secrets.token_hex(32))"
# 注意：不设置时每次进程重启会随机生成 → 所有登录态/token 全部失效
FLASK_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---- 数据库 ----
# 默认连本机 MariaDB；生产建议显式填写真实密码
DATABASE_URL=mysql+pymysql://construction_user:CHANGE_ME@localhost/construction?charset=utf8mb4

# ---- 上传目录（生产建议绝对路径）----
UPLOAD_FOLDER=uploads

# ---- 上传体积上限（字节）----
# 请求总体积 100MB（聊天大文件需同步调大 Nginx client_max_body_size）
MAX_CONTENT_LENGTH=104857600
# 单文件上限 100MB（与上传白名单共同约束）
MAX_CHAT_FILE_SIZE=104857600
# 聊天图片上限 2MB（超过直接拒绝；前端已 70% 压缩，正常照片到不了这数）
MAX_CHAT_IMAGE_SIZE=2097152
# 聊天图片服务端统一压缩参数：长边上限 px / JPEG·WebP 质量
# 1280px+q80 下照片通常 200~400KB；需要管理页放大看细节可调高长边
CHAT_IMAGE_MAX_EDGE=1280
CHAT_IMAGE_QUALITY=80

# ---- CORS / Socket.IO ----
# 内网 + frp 场景保持 * 即可
CORS_ORIGINS=*
# 生产用 gunicorn gevent 时由 engineio 自动检测，无需配置；
# 仅开发直跑（python app.py）时按需设置 threading/eventlet
# SOCKETIO_ASYNC_MODE=threading

# ---- 开发模式直跑（可选）----
# HOST=0.0.0.0
# PORT=5000
