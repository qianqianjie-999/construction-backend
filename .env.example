# ============================================================
# Construction Backend — 环境变量配置
# 开发环境: FLASK_CONFIG=development (默认)
# 生产环境: FLASK_CONFIG=production
# ============================================================

# Flask
FLASK_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING          # 生产必须改！
FLASK_DEBUG=false                                            # 生产关
FLASK_CONFIG=production                                      # development / production

# 数据库
DATABASE_URL=mysql+pymysql://construction_user:construction123@localhost/construction?charset=utf8mb4

# 上传
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=20971520                                  # 20MB

# 服务器（内网小主机本地监听）
HOST=0.0.0.0
PORT=5000

# ---- 生产环境专用 ----

# CORS（* 表示全部允许；生产建议填具体域名，如 https://api.example.com）
CORS_ORIGINS=*

# Socket.IO async_mode: threading(开发) / eventlet(生产推荐)
SOCKETIO_ASYNC_MODE=eventlet
SOCKETIO_CORS_ORIGINS=*
