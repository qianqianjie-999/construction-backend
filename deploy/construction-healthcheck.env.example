# /etc/construction-healthcheck.env —— 探活自愈脚本的配置（权限必须 600）
#
# 三选一，脚本按 webhook 域名自动适配报文格式；全部留空则只写 journald。
#
# 1) 企业微信群机器人（若你有企业微信）
#    NOTIFY_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
#
# 2) 钉钉群机器人
#    NOTIFY_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
#    安全设置选「自定义关键词」填 construction-backend（推荐），则 NOTIFY_SECRET 留空
#    选「加签」则把 SEC 开头的密钥填到 NOTIFY_SECRET
#
# 3) PushPlus —— 推送到个人微信，最省事
#    微信扫码登录 https://www.pushplus.plus 复制 token
#    NOTIFY_WEBHOOK=pushplus
#    NOTIFY_TOKEN=你的token
NOTIFY_WEBHOOK=
NOTIFY_SECRET=
NOTIFY_TOKEN=
