# /etc/construction-healthcheck.env —— 探活自愈脚本的配置（权限必须 600）
#
# ============ 邮件告警（当前使用）============
# NOTIFY_EMAIL_PASS 填 163 邮箱的「客户端授权码」，不是登录密码
# 获取：163 邮箱网页版 -> 设置 -> POP3/SMTP/IMAP -> 开启 SMTP 服务 -> 新增授权密码
NOTIFY_EMAIL_TO=yanjie086@163.com
NOTIFY_EMAIL_USER=yanjie086@163.com
NOTIFY_EMAIL_PASS=
NOTIFY_EMAIL_HOST=smtp.163.com
NOTIFY_EMAIL_PORT=465

# ============ 群机器人 / 微信推送（留空即不启用）============
# 企业微信: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 钉钉:     https://oapi.dingtalk.com/robot/send?access_token=xxx
# 飞书:     https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# PushPlus: NOTIFY_WEBHOOK=pushplus 并填 NOTIFY_TOKEN
NOTIFY_WEBHOOK=
NOTIFY_SECRET=
NOTIFY_TOKEN=
