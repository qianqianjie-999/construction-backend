# /etc/construction-healthcheck.env —— 探活自愈脚本的配置（权限必须 600）
#
# 支持两种机器人，脚本按 webhook 域名自动适配报文格式：
#   飞书自定义机器人  https://open.feishu.cn/open-apis/bot/v2/hook/xxx
#   钉钉自定义机器人  https://oapi.dingtalk.com/robot/send?access_token=xxx
# 留空则只写 journald，不发通知。
NOTIFY_WEBHOOK=

# 钉钉机器人安全设置：
#   选「自定义关键词」-> 关键词填 construction-backend，此项留空
#   选「加签」      -> 填 SEC 开头的密钥
NOTIFY_SECRET=
